[Unit]
Description=VetTV Retro OS: grow root to fill the disk (first boot)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target systemd-tmpfiles-setup.service
ConditionPathExists=!/var/lib/vettv/grow-root.done

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/vettv-grow-root

[Install]
WantedBy=sysinit.target
