# VetTV Retro OS Plymouth script. Plymouth calls refresh at 50 Hz (every 20 ms).
# FRAME_TICKS = 4  ->  one spinner frame every 80 ms; 12 frames = 960 ms per sweep.
FRAME_TICKS = 4;
NFRAMES = 12;
sw = Window.GetWidth(); sh = Window.GetHeight();
if (sw > 1920) bg_img = Image("vtl_plymouth_bg_3840x2160_v01.png"); else bg_img = Image("vtl_plymouth_bg_1920x1080_v01.png");
bg = Sprite(bg_img.Scale(sw, sh)); bg.SetZ(-100);
logo_img = Image("vtl_plymouth_logo_256_v02.png");
logo = Sprite(logo_img); logo.SetX(sw/2 - logo_img.GetWidth()/2); logo.SetY(sh/2 - logo_img.GetHeight()/2 - 60);
for (i = 0; i < NFRAMES; i++) {
  n = i + 1; if (n < 10) name = "throbber-000" + n + ".png"; else name = "throbber-00" + n + ".png";
  frames[i] = Image(name);
}
spin = Sprite(frames[0]); spin.SetX(sw/2 - 32); spin.SetY(sh/2 + 120);
tick = 0;
fun refresh_cb() { tick++; spin.SetImage(frames[Math.Int(tick / FRAME_TICKS) % NFRAMES]); }
Plymouth.SetRefreshFunction(refresh_cb);
entry_img = Image("vtl_plymouth_entry_400x48_v01.png"); bullet_img = Image("vtl_plymouth_bullet_12_v01.png");
entry = Sprite(); bullets = [];
fun display_password_cb(prompt, n) {
  entry.SetImage(entry_img); entry.SetX(sw/2 - 200); entry.SetY(sh/2 + 200); entry.SetOpacity(1);
  for (i = 0; i < 32; i++) { if (!bullets[i]) bullets[i] = Sprite(bullet_img); bullets[i].SetX(sw/2 - 188 + i*16); bullets[i].SetY(sh/2 + 218); if (i < n) bullets[i].SetOpacity(1); else bullets[i].SetOpacity(0); }
}
fun display_normal_cb() { entry.SetOpacity(0); for (i = 0; i < 32; i++) if (bullets[i]) bullets[i].SetOpacity(0); }
Plymouth.SetDisplayPasswordFunction(display_password_cb);
Plymouth.SetDisplayNormalFunction(display_normal_cb);
