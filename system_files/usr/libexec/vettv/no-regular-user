#!/bin/bash
# ExecCondition for plasma-setup.service (VetTV): run the first-run wizard only
# when no regular user exists. Regular = UID_MIN..UID_MAX from login.defs
# (default 1000..60000). Exit 0 = run the wizard, exit 1 = skip it.
min=1000; max=60000
for f in /etc/login.defs /usr/etc/login.defs; do
  [ -r "$f" ] || continue
  a=$(awk '$1=="UID_MIN"{print $2}' "$f"); b=$(awk '$1=="UID_MAX"{print $2}' "$f")
  [ -n "$a" ] && min=$a; [ -n "$b" ] && max=$b
  [ -n "$a" ] && [ -n "$b" ] && break
done
users=$(getent passwd | awk -F: -v a="$min" -v b="$max" '$3>=a && $3<=b {print $1"("$3")"}' | tr '\n' ' ')
if [ -n "$users" ]; then
  echo "vettv: regular user(s) present: ${users}- plasma-setup skipped"
  exit 1
fi
echo "vettv: no regular user (UID ${min}-${max}) - starting plasma-setup"
exit 0
