#!/bin/sh
# First-boot: install DOSBox-X from Flathub at a PINNED commit (same on Fedora 44 and Debian 13).
# Pin lives in /usr/share/vettv/flatpak-pins.env (pinned 2026-11-02).
set -e
. /usr/share/vettv/flatpak-pins.env
[ "${DOSBOX_X_GATE:-pending}" = passed ] || { echo "vettv-dosbox-x: pin not cleared by the Wolf gate; skipping install" >&2; exit 0; }
APP=$DOSBOX_X_APP; VER=$DOSBOX_X_VER; COMMIT=$DOSBOX_X_COMMIT
case "$COMMIT" in "") echo "vettv-dosbox-x: COMMIT not pinned, refusing to install" >&2; exit 1;; esac
[ -e /var/lib/vettv/dosbox-x-flatpak.done ] && exit 0
flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
flatpak install --system -y --noninteractive flathub $APP
flatpak update --system -y --noninteractive --commit=$COMMIT $APP
flatpak mask --system $APP   # stop auto-updates drifting off the pin
got=$(flatpak info --system --show-commit $APP)
[ "$got" = "$COMMIT" ] || { echo "vettv-dosbox-x: installed commit $got != pinned $COMMIT" >&2; exit 1; }
# Runtime pin (Faye 11-17 beta rule; Priya 11-25): hold org.freedesktop.Platform at the pinned commit too.
RT=$DOSBOX_X_RUNTIME; RTC=$DOSBOX_X_RUNTIME_COMMIT
case "$RT$RTC" in *[!A-Za-z0-9._/-]*|"") echo "vettv-dosbox-x: runtime not pinned, refusing" >&2; exit 1;; esac
flatpak update --system -y --noninteractive --commit=$RTC $RT
flatpak mask --system $RT
got=$(flatpak info --system --show-commit $RT)
[ "$got" = "$RTC" ] || { echo "vettv-dosbox-x: runtime commit $got != pinned $RTC" >&2; exit 1; }
# Game folders: grant read-only access to the h2h game mount (QA must verify sandbox access).
flatpak override --system --filesystem=/srv/games:ro --filesystem=~/games:ro \
  --filesystem=/opt/vettv-h2h:ro --filesystem=xdg-state/vettv-h2h:create $APP
# Shim so vetvdm-h2h.sh's default VETTV_DOSBOX path works unchanged on both distros.
if [ ! -x /opt/dosbox-x/bin/dosbox-x ]; then
  mkdir -p /opt/dosbox-x/bin
  printf '#!/bin/sh\nexec flatpak run --command=dosbox-x %s "$@"\n' $APP > /opt/dosbox-x/bin/dosbox-x
  chmod 755 /opt/dosbox-x/bin/dosbox-x
fi
mkdir -p /var/lib/vettv && flatpak info --system $APP > /var/lib/vettv/dosbox-x-flatpak.done
